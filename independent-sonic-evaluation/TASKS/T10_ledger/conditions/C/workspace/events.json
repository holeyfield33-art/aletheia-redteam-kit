          "kind": "branch",
          "condition": "not isinstance(balance, int) or isinstance(balance, bool) or balance < 0",
          "body": [
            {
              "kind": "raise",
              "expression": "ValueError('invalid starting balance')"
            }
          ],
          "otherwise": []
        },
        {
          "kind": "assign",
          "target": "current",
          "expression": "balance"
        },
        {
          "kind": "assign",
          "target": "rejected",
          "expression": "[]"
