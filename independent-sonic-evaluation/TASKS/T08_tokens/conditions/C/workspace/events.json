      "body": [
        {
          "kind": "assign",
          "target": "parts",
          "expression": "token.split('.')"
        },
        {
          "kind": "branch",
          "condition": "len(parts) != 3",
          "body": [
            {
              "kind": "raise",
              "expression": "ValueError('malformed token')"
            }
          ],
          "otherwise": []
        },
        {
          "kind": "assign",
          "target": "username",
          "expression": "parts[0]"
        },
        {
          "kind": "assign",
          "target": "expiry_text",
          "expression": "parts[1]"
        },
        {
          "kind": "assign",
          "target": "provided",
          "expression": "parts[2]"
        },
        {
          "kind": "branch",
          "condition": "not username or not expiry_text.isdigit()",
          "body": [
            {
              "kind": "raise",
              "expression": "ValueError('malformed token')"
            }
          ],
          "otherwise": []
        },
        {
          "kind": "hole",
          "label": "Set expected to the signature part of sign(username, int(expiry_text), secret); first assign expected_token = sign(...), then expected = expected_token.split('.')[2]",
          "allowed_calls": [
            "sign",
            "int",
            "expected_token.split"
          ]
        },
        {
          "kind": "branch",
          "condition": "not hmac.compare_digest(provided, expected)",
          "body": [
            {
              "kind": "raise",
              "expression": "PermissionError('bad signature')"
            }
          ],
          "otherwise": []
        },
        {
          "kind": "branch",
          "condition": "now >= int(expiry_text)",
          "body": [
            {
              "kind": "raise",
              "expression": "PermissionError('token expired')"
            }
          ],
          "otherwise": []
        },
        {
          "kind": "return",
          "expression": "username"
        }
      ],
      "requirements": []
    }
